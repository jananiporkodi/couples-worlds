# The one shared secret that unlocks the app. Change this to something only
# the two of you know before you share the app with each other.
APP_PASSCODE=change-me

# Neon Postgres connection string. Find it in the Neon console under your
# project -> Connect, or via the Neon MCP get_connection_string tool.
# Must use the pooled ("-pooler") host for serverless/edge use on Vercel.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Vercel Blob storage token. Create a Blob store in the Vercel dashboard
# (Project -> Storage -> Create Database -> Blob) and connect it to this
# project; Vercel injects this automatically for deployed environments.
# For local dev, run `vercel env pull .env.local` after connecting it, or
# paste the token from Project Settings -> Environment Variables.
BLOB_READ_WRITE_TOKEN=

# Optional: sends an email to the other partner whenever a memory is added.
# Get a free API key at https://resend.com. Leave unset to skip emailing entirely.
RESEND_API_KEY=
# Optional: defaults to Resend's shared sandbox sender if unset.
RESEND_FROM_EMAIL="Couples Worlds <onboarding@resend.dev>"

# The separate passcode that unlocks /admin (create/manage worlds).
# Unrelated to any couple's own passcode - set this to something only you know.
ADMIN_PASSCODE=change-me-admin
